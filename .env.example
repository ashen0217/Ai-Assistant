# ─── Local Ollama AI — https://ollama.com ────────────────────────────────────
# Powers: All chat, reasoning, summarization, and embeddings (fully local, no API key needed)
# Setup:
#   1. Install Ollama: https://ollama.com/download
#   2. Start Ollama: `ollama serve`
#   3. Pull models: `ollama pull qwen2.5:3b`
#                   `ollama pull nomic-embed-text`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ─── MongoDB — local instance, no account needed for development ──────────────
# Powers: User profile (name, emotion, focus, tech stack)
MONGODB_URI=mongodb://localhost:27017/?directConnection=true

# ─── Pinecone — https://app.pinecone.io ──────────────────────────────────────
# Powers: Vector database for semantic long-term memory
# Note: Uses a new index "assistant-memory-local" with 768 dimensions (nomic-embed-text)
PINECONE_API_KEY=pcsk_your_pinecone_api_key_here

# ─── Groq (OPTIONAL) — https://console.groq.com ──────────────────────────────
# ONLY needed if you want voice-to-text transcription via Whisper.
# Leave blank or remove entirely to disable voice input.
GROQ_API_KEY=gsk_your_groq_api_key_here
