# ─── Groq API — https://console.groq.com ────────────────────────────────────
# Powers: Llama 4 Scout Vision, Whisper Large v3 Turbo STT, Llama 3.1 summaries
GROQ_API_KEY=gsk_your_groq_api_key_here

# ─── Google Gemini — https://aistudio.google.com/app/apikey ─────────────────
# Powers: gemini-embedding-001 (3072-dim vectors for long-term memory)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# ─── Pinecone — https://app.pinecone.io ──────────────────────────────────────
# Powers: Vector database for semantic long-term memory
PINECONE_API_KEY=pcsk_your_pinecone_api_key_here

# ─── MongoDB — local instance, no account needed for development ──────────────
# Powers: User profile (name, emotion, focus, tech stack)
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
